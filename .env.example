# Copy to .env and fill in your keys (rotate any keys that were ever committed).
COINGECKO_API_KEY=
MAGICLABS_JWT=
MAGICLABS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_APP_URL=https://github.com/softwaretech412/Trading-bot-with-Python
OPENROUTER_APP_NAME=QUANT Grid Trader

# Optional runtime config (non-interactive defaults)
SELECTED_SYMBOLS=all
THRESHOLDS=
CHECK_INTERVAL=30
MAX_API_RETRIES=5
API_RETRY_BACKOFF_BASE=2
RETRY_JITTER_SECONDS=0.3
MAX_BACKOFF_SECONDS=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
COINGECKO_TIMEOUT_SECONDS=10
MAGICLABS_TIMEOUT_SECONDS=15
OPENROUTER_TIMEOUT_SECONDS=60
TARGET_LATENCY_MAGICLABS_MS=3000
TARGET_LATENCY_COINGECKO_MS=2000
TARGET_LATENCY_OPENROUTER_MS=15000
TARGET_LATENCY_CYCLE_MS=30000
METRICS_WINDOW_SIZE=100
METRICS_REPORT_EVERY_CYCLES=10
LOG_LEVEL=INFO
